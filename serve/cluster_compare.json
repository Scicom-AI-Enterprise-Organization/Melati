{
 "run_dir": "${MELATI_DATA}/serve_compare",
 "endpoints": "${MELATI_DATA}/serve_compare/endpoints.json",
 "startup_timeout_s": 1500,
 "env": {
  "HF_HOME": "${MELATI_DATA}/hf",
  "HF_HUB_DISABLE_XET": "1",
  "VLLM_CONFIGURE_LOGGING": "1"
 },
 "services": {
  "front": {
   "kind": "app",
   "app": "serve.front_server:app",
   "port": 17300,
   "replicas": [
    [
     5
    ]
   ],
   "env": {
    "SEP_MAX_BATCH": 4,
    "SED_MAX_BATCH": 8
   }
  },
  "align": {
   "kind": "app",
   "app": "serve.align_server:app",
   "port": 17400,
   "replicas": [
    [
     5
    ]
   ],
   "env": {
    "MAX_BATCH": 16
   },
   "venv": "${MELATI_ROOT}/.venv-align"
  }
 }
}